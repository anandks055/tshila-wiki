# Copy to /opt/wiki-api/.env on the Oracle VM
STATIC_DIR=/data/wiki-articles
PORT=7171
ENABLE_REGENERATE=false

# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=https://www.bheri.in

# Shared secret; frontend must send this as X-API-Key on every request
API_KEY=replace-with-a-long-random-string
